{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Review Checklists corpus bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "corpusVersion", "contentHash", "recommendations"],
  "properties": {
    "schemaVersion": {"type": "integer", "const": 1},
    "corpusVersion": {"type": "string", "minLength": 1, "maxLength": 200},
    "contentHash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "recommendations": {"type": "array", "minItems": 1, "items": {"type": "object"}}
  }
}
