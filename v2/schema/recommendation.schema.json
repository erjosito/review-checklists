{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://github.com/Azure/review-checklists/v2/recommendation.schema.json",
    "title": "Recommendation",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "schemaVersion": {"type": "integer", "const": 1},
        "id": {"type": "string", "format": "uuid"},
        "guid": {"type": "string", "format": "uuid", "deprecated": true},
        "services": {
            "type": "array",
            "description": "Explicit service classification. Empty means not curated; resourceTypes remain available for compatibility.",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
        },
        "automation": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "validatedAt"],
            "properties": {
                "status": {"enum": ["unknown", "manual", "candidate", "query_available"]},
                "resultSemantics": {"enum": ["unknown", "violations", "inventory", "compliance"]},
                "complianceColumn": {"type": "string", "minLength": 1},
                "validatedAt": {"type": ["string", "null"], "format": "date"},
                "notes": {"type": "string", "minLength": 1}
            }
        },
        "provenance": {
            "type": "object",
            "additionalProperties": false,
            "required": ["upstreamRevision", "lastReviewed", "sources"],
            "properties": {
                "upstreamRevision": {"type": ["string", "null"], "minLength": 1},
                "lastReviewed": {"type": ["string", "null"], "format": "date"},
                "upstreamRecommendations": {
                    "type": "array",
                    "description": "Explicit mappings to identified upstream recommendations, independent of original import source.",
                    "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["sourceId", "recommendationId", "url", "coverage", "assessedAt", "notes"],
                        "properties": {
                            "sourceId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
                            "recommendationId": {"type": "string", "pattern": "\\S"},
                            "url": {"type": "string", "format": "uri"},
                            "coverage": {"enum": ["full", "partial", "supporting"]},
                            "assessedAt": {"type": "string", "format": "date"},
                            "upstreamContentHash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
                            "notes": {"type": "string", "pattern": "\\S"}
                        },
                        "allOf": [
                            {
                                "if": {"properties": {"coverage": {"enum": ["full", "partial"]}}},
                                "then": {"required": ["upstreamContentHash"]}
                            }
                        ]
                    }
                },
                "sources": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["url"],
                        "properties": {
                            "url": {"type": "string", "format": "uri"},
                            "title": {"type": "string", "minLength": 1},
                            "accessedAt": {"type": ["string", "null"], "format": "date"},
                            "revision": {"type": ["string", "null"], "minLength": 1}
                        }
                    }
                }
            }
        },
        "aliases": {
            "type": "array",
            "description": "Retired recommendation identities retained after confirmed duplicate merges.",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "name"],
                "properties": {
                    "id": {"type": "string", "format": "uuid"},
                    "name": {"type": "string", "minLength": 1, "maxLength": 100},
                    "source": {"$ref": "#/properties/source"},
                    "labels": {"$ref": "#/properties/labels"},
                    "corpusFile": {"type": "string", "minLength": 1}
                }
            }
        },
        "name": {
            "type": "string",
            "description": "Unique identifier for the recommendation, human readable.",
            "pattern": "^[0-9A-Za-z\\-]+$",
            "minLength": 5,
            "maxLength": 100,
            "$comment": "Names added for human readability, even if not strictly necessary when having GUIDs."
        },
        "title": {
            "type": "string",
            "description": "Recommendation text.",
            "minLength": 5,
            "maxLength": 1000
        },
        "description": {
            "type": "string",
            "description": "More verbose recommendation description.",
            "maxLength": 2000
        },
        "severity": {
            "type": "integer",
            "description": "Severity of the recommendation.",
            "enum": [0, 1, 2],
            "$comment": "0: High, 1: Medium, 2: Low"
        },
        "waf": {
            "type": "string",
            "description": "WAF pillar.",
            "enum": ["Security", "Performance", "Reliability", "Cost", "Operations"]
        },
        "source": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type"],
            "anyOf": [{"required": ["file"]}, {"required": ["url"]}],
            "description": "Source of the recommendation.",
            "properties": {
                "type": {
                    "type": "string",
                    "description": "Type of the source.",
                    "enum": ["revcl", "aprl", "wafsg", "curated"]
                },
                "file": {"type": "string", "minLength": 1},
                "timestamp": {"type": "string", "minLength": 1},
                "url": {
                    "type": "string",
                    "format": "uri",
                    "description": "Public source URL."
                }
            }
        },
        "reviewedDate": {
            "type": "string",
            "description": "Legacy recorded review date, not the upstream ingestion timestamp.",
            "format": "date"
        },
        "resourceTypes": {
            "type": "array",
            "description": "List of resource types that this recommendation applies to.",
            "items": {
                "type": "string",
                "minLength": 5,
                "maxLength": 100
            }
        },
        "automatable": {
            "type": "boolean",
            "deprecated": true,
            "description": "Whether this check can be automated via some kind of query, such as Azure Resource Graph."
        },
        "queries": {
            "type": "object",
            "additionalProperties": false,
            "description": "Query to find the resources that this recommendation applies to.",
            "properties": {
                "arg": {
                    "type": "string",
                    "description": "Azure Resource Graph query"
                }
            }
        },
        "links": {
            "type": "array",
            "description": "List of links to documentation or other resources.",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["type", "url"],
                "properties": {
                    "type": {
                        "type": "string",
                        "description": "target type.",
                        "enum": ["docs", "training", "other"]
                    },
                    "url": {
                        "type": "string",
                        "format": "uri",
                        "description": "Link URL."
                    }
                }
            }
        },
        "labels": {
            "type": "object",
            "properties": {"guid": {"type": "string", "format": "uuid"}},
            "description": "Optional labels for the recommendation."
        },
        "constraints": {
            "type": "array",
            "description": "List of constraints that this recommendation applies to.",
            "items": {
                "type": "object",
                "properties": {
                    "field": {
                        "type": "string",
                        "description": "Variable to compare."
                    },
                    "operator": {
                        "type": "string",
                        "description": "Comparison operator.",
                        "enum": ["equals", "greater", "less", "contains", "startsWith", "endsWith"]
                    },
                    "value": {
                        "type": "string",
                        "description": "Value to compare against"
                    },
                    "effect": {
                        "type": "string",
                        "description": "Effect of the constraint.",
                        "enum": ["show", "hide"],
                        "$comment": "Show or hide the recommendation."
                    }
                }
            }
        },
        "duplicates": {
            "type": "array",
            "description": "List of names of recommendations that are duplicates of this one.",
            "items": {
                "type": "string",
                "minLength": 36,
                "maxLength": 36
            }
        }
    },
    "required": ["schemaVersion", "id", "name", "title", "severity", "source", "resourceTypes", "services", "automation", "provenance"],
    "allOf": [
        {
            "if": {"properties": {"automation": {"properties": {"status": {"const": "query_available"}}}}},
            "then": {
                "required": ["queries"],
                "properties": {
                    "queries": {"required": ["arg"], "properties": {"arg": {"pattern": "\\S"}}},
                    "automation": {"required": ["resultSemantics"]}
                }
            },
            "else": {
                "properties": {
                    "queries": {"properties": {"arg": {"pattern": "^\\s*$"}}},
                    "automation": {"properties": {"resultSemantics": {"const": "unknown"}}}
                }
            }
        },
        {
            "if": {"properties": {"automation": {"required": ["resultSemantics"], "properties": {"resultSemantics": {"const": "compliance"}}}}},
            "then": {"properties": {"automation": {"required": ["complianceColumn"]}}}
        }
    ]
}
